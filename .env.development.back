# The backend listens on container port 3000, mapped to host port 13000.
PORT=3000

# Docker DNS resolves the database by its container name on todo-net.
DB_HOST=todo-db-container
DB_PORT=5432
# These values match POSTGRES_* in .env.development.db.
DB_USER=todo
DB_PASSWORD=todo
DB_NAME=todo

# Browser requests originate from the host-facing frontend URL.
CORS_ORIGIN=http://localhost:18080
